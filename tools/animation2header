##############################################################################
# animation2header - convert PNGs to a C header for contiguous sprite sheets
#
# Contiguous data reads on the Cortex M7 are VERY FAST.
#
# The .progmem section attribute keeps the array in QSPI flash on Teensy 4.x.
# Pixels with alpha < 16 are written as 0xF81F (magenta chroma-key), matching
# the transparent sentinel used by the pulse2d renderer.
#
# Usage:
#   animation2header <output.h> <array_name> <width> <height> <1.png> <2.png> ...
##############################################################################

import sys
from pathlib import Path

try:
    from PIL import Image
except ImportError:
    sys.exit("error: Pillow is not installed - run: pip3 install Pillow")


class Conversion_Error(Exception):
    __module__ = "png2header"


class Header_Writer:

    _COLS = 12

    def __init__(self, dst: str, name: str, width: int, height: int) -> None:
        self.dst    = dst
        self.name   = name
        self.width  = width
        self.height = height


    def get_image(self, src: str) -> Image.ImageFile:
        try:
            return Image.open(src).convert("RGBA").resize(
                (self.width, self.height), Image.NEAREST
            )
        except FileNotFoundError:
            raise Conversion_Error(f"input file not found: {src}") from None
        except Exception as e:
            raise Conversion_Error(f"could not open image: {e}") from None


    def get_pixels(self, img: Image.ImageFile) -> list[int]:
        pixels = []
        for y in range(self.height):
            for x in range(self.width):
                r, g, b, a = img.getpixel((x, y))
                if a < 16:
                    pixels.append(0xF81F)
                else:
                    pixels.append(((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3))
        return pixels

    def write_header(self, count: int) -> None:
        with open(self.dst, "w") as f:
            f.write(f"// Generated by animation2header - do not edit this file manually.\n")
            f.write("#pragma once\n\n")
            f.write("#include <cstdint>\n\n")
            f.write(f"static constexpr uint16_t {self.name}_width  = {self.width};\n")
            f.write(f"static constexpr uint16_t {self.name}_height = {self.height};\n\n")
            f.write(f"__attribute__((section(\".progmem\"), aligned(32)))\n")
            f.write(f"static constexpr uint16_t {self.name}[{self.width} * {self.height} * {count}] = {{\n")


    def write_footer(self) -> None:
        with open(self.dst, "a") as f:
            f.write("};\n")


    def convert(self, name: str, pixels: list[int]) -> None:
        with open(self.dst, "a") as f:
            f.write(f"    // Image index: {name}\n")
            for i, px in enumerate(pixels):
                if i % self._COLS == 0:
                    f.write("    ")
                f.write(f"0x{px:04X}")
                f.write(", ")
                if (i + 1) % self._COLS == 0:
                    f.write("\n")
            if len(pixels) % self._COLS != 0:
                f.write("\n")
            f.write("\n")

def main() -> None:
    sys.tracebacklimit = 0
    try:
        """Convert convert PNGs to a C header for contiguous sprite sheets.

        Args:
            argv: <output.h> <array_name> <width> <height> <1.png> <2.png> ...

        """
        if len(sys.argv) < 7:
            sys.exit(
                "usage: animation2header <output.h> <array_name> <width> <height> <1.png> <2.png> ...\n"
                "  e.g. animation2header laser.h laser_anim 45 32 sprite1.png sprite2.png sprite3.png"
            )

        _, dst, name, w_str, h_str, *rest = sys.argv

        try:
            w, h = int(w_str), int(h_str)
        except ValueError:
            raise Conversion_Error("width and height must be integers") from None

        if w <= 0 or h <= 0:
            raise Conversion_Error("width and height must be positive")

        if w > 96 or h > 96:
            raise Conversion_Error(f"PNGs may be no larger than 96x96 pixels") from None

        if not name.isidentifier():
            raise Conversion_Error("array_name must be a valid C identifier")

        header_writer = Header_Writer(dst, name, w, h)

        header_writer.write_header(len(rest))

        for i_src in rest:
            img = header_writer.get_image(i_src)
            pixels = header_writer.get_pixels(img)
            header_writer.convert(Path(i_src).stem, pixels)

        header_writer.write_footer()

    except Conversion_Error as e:
        sys.exit(f"error: {e}")


if __name__ == "__main__":
    main()
