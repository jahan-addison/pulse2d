# png2header — convert a PNG to a C header for RGB565 background assets
#
# Format written:
#   static constexpr uint16_t <name>_width  = <width>;
#   static constexpr uint16_t <name>_height = <height>;
#   __attribute__((section(".progmem")))
#   static constexpr uint16_t <name>[<width> * <height>] = { ... };
#
# The .progmem section attribute keeps the array in QSPI flash on Teensy 4.x;
# without it the linker script copies all .rodata into DTCM at boot,
# consuming up to 150 KB of DTCM per 320x240 image.
# Pixels with alpha < 16 are written as 0xF81F (magenta chroma-key), matching
# the transparent sentinel used by the pulse2d renderer.
#
# Usage:
#   png2header <input.png> <output.h> <array_name> <width> <height>

import sys

try:
    from PIL import Image
except ImportError:
    sys.exit("error: Pillow is not installed — run: pip3 install Pillow")


class Conversion_Error(Exception):
    __module__ = "png2header"


class Header_Writer:
    """PNG to C header RGB565 array writer.

    Opens and resizes a source image, encodes it as RGB565, and writes
    a C header with a .progmem-attributed constexpr array.

    Args:
        src: Path to the input PNG file.
        dst: Path to the output .h file.
        name: C identifier used as the array name prefix.
        width: Target width in pixels.
        height: Target height in pixels.

    Attributes:
        src: Input file path.
        dst: Output file path.
        name: C array name prefix.
        width: Target width.
        height: Target height.

    """

    _COLS = 12

    def __init__(self, src: str, dst: str, name: str, width: int, height: int) -> None:
        self.src    = src
        self.dst    = dst
        self.name   = name
        self.width  = width
        self.height = height

    def convert(self) -> None:
        """Encode the image and write the C header.

        Returns:
            None

        """
        try:
            img = Image.open(self.src).convert("RGBA").resize(
                (self.width, self.height), Image.NEAREST
            )
        except FileNotFoundError:
            raise Conversion_Error(f"input file not found: {self.src}") from None
        except Exception as e:
            raise Conversion_Error(f"could not open image: {e}") from None

        pixels = []
        for y in range(self.height):
            for x in range(self.width):
                r, g, b, a = img.getpixel((x, y))
                if a < 16:
                    pixels.append(0xF81F)
                else:
                    pixels.append(((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3))

        with open(self.dst, "w") as f:
            f.write(f"// Generated by png2header from {self.src} — do not edit this file manually.\n")
            f.write("#pragma once\n\n")
            f.write("#include <cstdint>\n\n")
            f.write(f"static constexpr uint16_t {self.name}_width  = {self.width};\n")
            f.write(f"static constexpr uint16_t {self.name}_height = {self.height};\n\n")
            f.write(f"__attribute__((section(\".progmem\")))\n")
            f.write(f"static constexpr uint16_t {self.name}[{self.width} * {self.height}] = {{\n")
            for i, px in enumerate(pixels):
                if i % self._COLS == 0:
                    f.write("    ")
                f.write(f"0x{px:04X}")
                if i < len(pixels) - 1:
                    f.write(", ")
                if (i + 1) % self._COLS == 0:
                    f.write("\n")
            if len(pixels) % self._COLS != 0:
                f.write("\n")
            f.write("};\n")

        print(
            f"{self.src} → {self.dst}  ({self.width}×{self.height}, "
            f"{self.width * self.height * 2} bytes)"
        )


def main() -> None:
    sys.tracebacklimit = 0
    try:
        """Convert a PNG to a C header with a .progmem-attributed RGB565 array.

        Args:
            argv: <input.png> <output.h> <array_name> <width> <height>

        """
        if len(sys.argv) != 6:
            sys.exit(
                "usage: png2header <input.png> <output.h> <array_name> <width> <height>\n"
                "  e.g. png2header background.png bg_title.h bg_title 320 240"
            )

        _, src, dst, name, w_str, h_str = sys.argv

        try:
            w, h = int(w_str), int(h_str)
        except ValueError:
            raise Conversion_Error("width and height must be integers") from None

        if w <= 0 or h <= 0:
            raise Conversion_Error("width and height must be positive")

        if not name.isidentifier():
            raise Conversion_Error("array_name must be a valid C identifier")

        Header_Writer(src, dst, name, w, h).convert()

    except Conversion_Error as e:
        sys.exit(f"error: {e}")


if __name__ == "__main__":
    main()
