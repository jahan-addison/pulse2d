##############################################################################
# sections - print a sorted section table for a Teensy ELF
#
# Reads the compiled ELF and maps every output section to its memory region
# (FLASH, DTCM, RAM/OCRAM, ERAM) using the known Teensy 4.x address ranges.
# Sections smaller than --min-bytes are hidden by default; pass --all to
# show everything.
#
# Usage:
#   sections <elf>  [--all] [--min-bytes N]
##############################################################################

import argparse
import struct
import sys
from collections import defaultdict
from pathlib import Path
from typing import Optional


_REGIONS = [
    (0x60000000, 0x60000000 + 8 * 1024 * 1024,  "FLASH"),
    (0x20000000, 0x20000000 + 512 * 1024,        "DTCM"),
    (0x20200000, 0x20200000 + 512 * 1024,        "RAM"),
    (0x70000000, 0x70000000 + 32 * 1024 * 1024,  "ERAM"),
    (0x00000000, 0x00000000 + 512 * 1024,        "ITCM"),
]

_REGION_CAPACITY = {
    "FLASH": 8 * 1024 * 1024,
    "DTCM":  512 * 1024,
    "RAM":   512 * 1024,
    "ERAM":  32 * 1024 * 1024,
    "ITCM":  512 * 1024,
}

# Static allocation thresholds above which the board may crash at runtime.
# Exceeding these does not immediately fail the build, so this tool is the
# only early warning.
#
#   DTCM  >312,000 bytes - less than 200 KB remains for the SdFat FIFO_SDIO
#                          DMA call stack (~128 KB) and the game's own frame stack
#   FLASH >6,000,000 bytes - leaves ~2 MB headroom in the 8 MB chip
#   ITCM  >450,000 bytes  - leaves ~60 KB for ISR code that must stay tightly coupled
#   RAM   >400,000 bytes  - leaves headroom for library DMA buffers and Teensy core
#   ERAM  >28,000,000 bytes - 87% of the optional 32 MB PSRAM; leave room for audio
#
# Thresholds use SI bytes (powers of 10) so that a raw byte count in the output
# can be compared directly: 316,288 bytes > 312,000 -> red.
_REGION_LIMIT = {
    "DTCM":  312_000,
    "FLASH": 6_000_000,
    "ITCM":  450_000,
    "RAM":   400_000,
    "ERAM":  28_000_000,
}

_ELF_MAGIC  = b"\x7fELF"
_SHF_ALLOC  = 0x2
_SHT_NOBITS = 8

_RESET  = "\033[0m"
_BOLD   = "\033[1m"
_DIM    = "\033[2m"
_CYAN   = "\033[1;36m"
_GREEN  = "\033[1;32m"
_YELLOW = "\033[1;33m"
_RED    = "\033[1;31m"

_REGION_COLOR = {
    "FLASH": _GREEN,
    "DTCM":  _YELLOW,
    "RAM":   _CYAN,
    "ERAM":  _DIM,
    "ITCM":  _CYAN,
    "?":     _RED,
}


class Parse_Error(Exception):
    __module__ = "sections"


class Section:
    """A single ELF output section with address and size metadata.

    Attributes:
        name: Section name string (e.g. .text, .data).
        vma: Virtual memory address - where the section runs.
        lma: Load memory address - where it lives in flash before copy.
        size: Section size in bytes.
        flags: ELF sh_flags field.
        stype: ELF sh_type field.

    """

    def __init__(
        self,
        name:  str,
        vma:   int,
        lma:   int,
        size:  int,
        flags: int,
        stype: int,
    ) -> None:
        self.name  = name
        self.vma   = vma
        self.lma   = lma
        self.size  = size
        self.flags = flags
        self.stype = stype


class Section_Table:
    """ELF section table parser and formatter for Teensy 4.x binaries.

    Parses a 32-bit ARM ELF and maps each allocatable section to its Teensy
    memory region, then renders a grouped, colour-coded table to stdout.

    Args:
        path: Path to the compiled .elf file.

    Attributes:
        path: The ELF file path.
        sections: Parsed list of Section objects.

    """

    def __init__(self, path: Path) -> None:
        self.path     = path
        self.sections = self._parse()

    def _region(self, addr: int) -> str:
        """Map a virtual address to a Teensy memory region name.

        Args:
            addr: The virtual address to classify.

        Returns:
            Region name: FLASH, DTCM, RAM, ERAM, or ?.

        """
        for start, end, name in _REGIONS:
            if start <= addr < end:
                return name
        return "?"

    def _parse(self) -> list[Section]:
        """Parse the ELF section headers.

        Returns:
            List of allocatable Section objects.

        """
        data = self.path.read_bytes()

        if data[:4] != _ELF_MAGIC:
            raise Parse_Error(f"{self.path} is not an ELF file")
        if data[4] != 1:
            raise Parse_Error("only 32-bit ELF is supported (Teensy is ARM Thumb-2)")

        endian = "<" if data[5] == 1 else ">"

        def u16(off: int) -> int:
            return struct.unpack_from(endian + "H", data, off)[0]

        def u32(off: int) -> int:
            return struct.unpack_from(endian + "I", data, off)[0]

        e_shoff     = u32(0x20)
        e_shentsize = u16(0x2e)
        e_shnum     = u16(0x30)
        e_shstrndx  = u16(0x32)

        def sh(i: int, field_off: int) -> int:
            return u32(e_shoff + i * e_shentsize + field_off)

        strtab_off  = sh(e_shstrndx, 0x10)
        strtab_size = sh(e_shstrndx, 0x14)
        strtab      = data[strtab_off : strtab_off + strtab_size]

        def cstr(off: int) -> str:
            end = strtab.index(b"\x00", off)
            return strtab[off:end].decode()

        e_phoff     = u32(0x1c)
        e_phentsize = u16(0x2a)
        e_phnum     = u16(0x2c)
        lma_map: list[tuple[int, int, int]] = []
        for i in range(e_phnum):
            base   = e_phoff + i * e_phentsize
            p_type  = u32(base + 0x00)
            p_vaddr = u32(base + 0x08)
            p_paddr = u32(base + 0x0c)
            p_memsz = u32(base + 0x14)
            if p_type == 1:  # PT_LOAD
                lma_map.append((p_vaddr, p_memsz, p_paddr))

        def vma_to_lma(vma: int) -> Optional[int]:
            for seg_vma, seg_memsz, seg_lma in lma_map:
                if seg_vma <= vma < seg_vma + seg_memsz:
                    return seg_lma + (vma - seg_vma)
            return None

        sections: list[Section] = []
        for i in range(e_shnum):
            sh_name  = sh(i, 0x00)
            sh_type  = sh(i, 0x04)
            sh_flags = sh(i, 0x08)
            sh_addr  = sh(i, 0x0c)
            sh_size  = sh(i, 0x14)

            if not (sh_flags & _SHF_ALLOC):
                continue
            if sh_size == 0:
                continue

            name = cstr(sh_name)
            lma  = vma_to_lma(sh_addr) if sh_addr else sh_addr
            sections.append(Section(
                name  = name,
                vma   = sh_addr,
                lma   = lma if lma is not None else sh_addr,
                size  = sh_size,
                flags = sh_flags,
                stype = sh_type,
            ))

        return sections

    def _fmt_size(self, n: int) -> str:
        """Format a byte count with optional KB annotation.

        Args:
            n: Size in bytes.

        Returns:
            Formatted string.

        """
        if n >= 1024:
            return f"{n:>10,}  ({n / 1024:.1f} KB)"
        return f"{n:>10,}"

    def _section_type(self, s: Section) -> str:
        """Classify a section as NOLOAD, FLASH-ONLY, or LOAD.

        Args:
            s: The section to classify.

        Returns:
            Type label string.

        """
        if s.stype == _SHT_NOBITS:
            return "NOLOAD"
        if s.vma == s.lma:
            return "FLASH-ONLY"
        return "LOAD"

    def print_table(self, min_bytes: int) -> None:
        """Print the section table grouped by memory region.

        Args:
            min_bytes: Omit sections smaller than this many bytes.

        Returns:
            None

        """
        visible = [s for s in self.sections if s.size >= min_bytes]
        if not visible:
            print("(no sections above threshold)")
            return

        all_by_region: dict[str, list[Section]] = defaultdict(list)
        for s in self.sections:
            all_by_region[self._region(s.vma)].append(s)

        by_region: dict[str, list[Section]] = defaultdict(list)
        for s in visible:
            by_region[self._region(s.vma)].append(s)

        region_totals = {
            region: sum(s.size for s in secs)
            for region, secs in all_by_region.items()
        }
        over_limit = {
            region: region_totals.get(region, 0) > limit
            for region, limit in _REGION_LIMIT.items()
        }

        if any(over_limit.values()):
            print(f"{_RED}{_BOLD}Lines in red exceed the recommended limits and may crash the Teensy{_RESET}")

        order    = ["FLASH", "DTCM", "RAM", "ERAM", "ITCM", "?"]
        col_name = max(max(len(s.name) for s in visible), 7)

        for region in order:
            if region not in by_region:
                continue
            group = sorted(by_region[region], key=lambda s: s.vma)
            total = region_totals.get(region, 0)
            color = _RED if over_limit.get(region, False) else _REGION_COLOR.get(region, "")

            cap     = _REGION_CAPACITY.get(region)
            cap_str = (f"{cap // (1024 * 1024)} MB" if cap and cap >= 1024 * 1024
                       else f"{cap // 1024} KB" if cap else "?")
            kib_str = f"{total / 1024:.1f} KiB" if total < 1024 * 1024 else f"{total / (1024 * 1024):.1f} MiB"
            print(f"\n{_BOLD}{color}── {region}{_RESET}  "
                  f"{_DIM}(total: {cap_str}, {total:,} bytes / {kib_str} in use){_RESET}")
            print(f"  {_DIM}{'SECTION':<{col_name}}  {'VMA':>10}  {'LMA':>10}  "
                  f"{'SIZE':>22}  TYPE{_RESET}")
            print(f"  {_DIM}{'-' * col_name}  {'----------':>10}  {'----------':>10}  "
                  f"{'----------------------':>22}  --------{_RESET}")

            for s in group:
                stype = self._section_type(s)
                print(f"  {color}{s.name:<{col_name}}{_RESET}  "
                      f"0x{s.vma:08x}  0x{s.lma:08x}  "
                      f"{self._fmt_size(s.size)}  {_DIM}{stype}{_RESET}")


def main() -> None:
    sys.tracebacklimit = 0
    try:
        """Print a sorted section table for a Teensy ELF.

        Args:
            argv: <elf> [--all] [--min-bytes N]

        """
        ap = argparse.ArgumentParser(
            description="Print a sorted section table for a Teensy ELF."
        )
        ap.add_argument("elf",         help="path to the compiled .elf file")
        ap.add_argument("--all",       action="store_true",
                        help="show all sections (default hides sections < --min-bytes)")
        ap.add_argument("--min-bytes", type=int, default=64, metavar="N",
                        help="hide sections smaller than N bytes (default: 64)")
        args = ap.parse_args()

        path = Path(args.elf)
        if not path.exists():
            raise Parse_Error(f"file not found: {path}")

        threshold = 0 if args.all else args.min_bytes
        Section_Table(path).print_table(threshold)

    except Parse_Error as e:
        sys.exit(f"error: {e}")


if __name__ == "__main__":
    main()
